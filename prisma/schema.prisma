generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Court {
  id         Int       @id @default(autoincrement())
  name       String
  city       String?
  judge      String?
  address    String?
  districtId Int?
  District   District? @relation(fields: [districtId], references: [id])
  Office     Office[]
}

model District {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  Court Court[]
}

model Note {
  id        Int      @id @default(autoincrement())
  name      String?
  text      String
  recordId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime
  Record    Record   @relation(fields: [recordId], references: [id])
}

model Office {
  id      Int      @id @default(autoincrement())
  name    String
  courtId Int?
  Court   Court?   @relation(fields: [courtId], references: [id])
  Record  Record[]
}

model Record {
  id             Int              @id @default(autoincrement())
  name           String
  order          String           @unique
  tracing        Tracing          @default(ACEPTA_CARGO)
  priority       Priority         @default(NULA)
  archive        Boolean          @default(false)
  favorite       Boolean          @default(false)
  defendant      String[]
  prosecutor     String[]
  insurance      String[]
  officeId       Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  code           String?
  code__VALUES   String?          @map("code) VALUES") @db.VarChar(50)
  Note           Note[]
  Office         Office?          @relation(fields: [officeId], references: [id])
  RecordsAndUser RecordsAndUser[]
  files          RecordFile[]
  messages       Message[]
  activity       RecordActivity[]

  @@index([tracing])
  @@index([priority])
  @@index([favorite])
  @@index([archive])
  @@index([updatedAt])
  @@index([tracing, priority, updatedAt])
  @@index([favorite, priority, updatedAt])
}

model RecordFile {
  id           Int          @id @default(autoincrement())
  recordId     Int?
  name         String
  url          String
  storagePath  String
  folderPath   String?
  type         String
  size         Int
  aiMatch      Boolean      @default(false)
  aiConfidence Float?
  category     FileCategory @default(DRIVE)
  createdAt    DateTime     @default(now())
  record       Record?      @relation(fields: [recordId], references: [id])
  messages     Message[]
}

model RecordsAndUser {
  recordId Int
  userId   Int
  Record   Record @relation(fields: [recordId], references: [id])
  User     User   @relation(fields: [userId], references: [id])

  @@id([recordId, userId])
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  name            String?
  googleId        String?
  verified        Boolean          @default(false)
  active          Boolean          @default(true)
  visible         Boolean          @default(true)
  role            Role             @default(USER)
  image           String?
  RecordsAndUser  RecordsAndUser[]
  viewConfig      UserViewConfig?
  chatMemberships ChatMember[]
  sentMessages    Message[]        @relation("MessageSender")
  notifications   Notification[]
  recordActivity  RecordActivity[]
}

model UserViewConfig {
  id               Int            @id @default(autoincrement())
  userId           Int            @unique
  tracingFilter    Tracing[]
  favoritesOnly    Boolean        @default(false)
  minPriority      Priority?
  fileCategories   FileCategory[]
  dashboardView    DashboardView  @default(OVERVIEW)
  assignedToMeOnly Boolean        @default(false)
  chatPanel        Boolean        @default(false)
  user             User           @relation(fields: [userId], references: [id])
}

model Chat {
  id        Int          @id @default(autoincrement())
  name      String?
  isGroup   Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   ChatMember[]
  messages  Message[]
}

model ChatMember {
  chatId     Int
  userId     Int
  joinedAt   DateTime @default(now())
  lastReadId Int?
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@id([chatId, userId])
}

model Message {
  id         Int         @id @default(autoincrement())
  chatId     Int
  senderId   Int
  text       String
  replyToId  Int?
  recordId   Int?
  fileId     Int?
  createdAt  DateTime    @default(now())
  chat       Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender     User        @relation("MessageSender", fields: [senderId], references: [id])
  replyTo    Message?    @relation("MessageReply", fields: [replyToId], references: [id])
  replies    Message[]   @relation("MessageReply")
  record     Record?     @relation(fields: [recordId], references: [id])
  file       RecordFile? @relation(fields: [fileId], references: [id])

  @@index([chatId, createdAt])
}

model Config {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model RecordActivity {
  id        Int      @id @default(autoincrement())
  recordId  Int
  userId    Int?
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  record    Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([recordId, createdAt])
}

model Notification {
  id        Int        @id @default(autoincrement())
  userId    Int
  type      NotifType
  title     String
  body      String
  entityId  Int?
  read      Boolean    @default(false)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

enum NotifType {
  RECORD_ASSIGNED
  RECORD_UPDATED
  CHAT_MESSAGE
}

enum DashboardView {
  OVERVIEW
  STAGE
  FOCUS
  HYBRID
}

enum FileCategory {
  DRIVE
  APARTADO
  EXPEDIENTE
}

enum Priority {
  NULA
  BAJA
  MEDIA
  ALTA
  URGENTE
  INACTIVO
}

enum Role {
  USER
  ADMIN
  PART
  CLIENT
}

enum Tracing {
  ACEPTA_CARGO
  ACTO_PERICIAL_REALIZADO
  PERICIA_REALIZADA
  SENTENCIA_O_CONVENIO_DE_PARTES
  HONORARIOS_REGULADOS
  EN_TRATATIVA_DE_COBRO
  TRAMITE_EN_CAMARA
  COBRADO
}
